{$KY_VAULT_ORIGIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	@api path /api/* /scim/* /livez /readyz
	handle @api {
		header >Content-Security-Policy "default-src 'none'; sandbox"
		reverse_proxy {$KY_CONTROL_PLANE} {
			header_down -Content-Security-Policy
			header_down -Clear-Site-Data
			header_down -Service-Worker-Allowed
			header_down -Refresh
			header_down -Link
		}
	}

	handle {
		root * /srv/kyguard-vault
		header Content-Security-Policy "default-src 'none'; script-src {$KY_VAULT_ORIGIN}/assets/ 'wasm-unsafe-eval'; worker-src {$KY_VAULT_ORIGIN}/assets/ {$KY_VAULT_ORIGIN}/sw.js; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		@uncached path /.well-known/kyguard-vault.json /assets/wasm_exec.js /assets/vault-crypto.wasm /vault/keyring-callback /sw.js
		header @uncached Cache-Control no-store
		try_files {path} /index.html
		file_server
	}
}
